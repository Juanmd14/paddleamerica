# Copiá este archivo como .env.local y completá los valores.
# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL pública del sitio (se usa en los links de confirmación de email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Emails de la app (avisos de inscripción) con Resend. Opcional: sin estas
# variables no se mandan emails, solo avisos en la cuenta. Solo servidor.
# Sin dominio verificado, Resend solo permite enviar desde onboarding@resend.dev
# al email de tu cuenta de Resend.
RESEND_API_KEY=
EMAIL_FROM=PaddleAmerica <no-responder@tudominio.com>

# Clave secreta de Supabase (Project Settings → API Keys → Secret keys).
# SOLO servidor, nunca con NEXT_PUBLIC_. La usa src/lib/supabase/admin.ts para
# leer el email de la pareja cuando un jugador la invita, acepta o cancela.
SUPABASE_SECRET_KEY=
